  "framework": "vite",
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build -- --mode vercel",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/agency", "destination": "/index.html" },
    { "source": "/agency/admin", "destination": "/index.html" },
