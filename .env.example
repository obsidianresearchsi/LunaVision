# Public browser configuration. Keep local values in .env.local.
VITE_MAPBOX_ACCESS_TOKEN=
# Public Supabase project settings for business and agency workspaces.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CRAWLER_API_URL=
VITE_WORKSPACE_PORTAL_ENABLED=false
VITE_GOOGLE_SIGN_IN_ENABLED=false
VITE_EMAIL_AUTH_FLOWS_ENABLED=true

# Server only. Never prefix this key with VITE_. Needed for staff account creation.
STAFF_SUPABASE_SERVICE_ROLE_KEY=
AGENCY_SETUP_ORIGIN=http://127.0.0.1:3000

# Face comparison requires server-only FACEPP_API_KEY and FACEPP_API_SECRET (and optional FACEPP_REGION=US|CN).
VITE_FACE_COMPARISON_ENABLED=false
